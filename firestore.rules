rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Each user's own finances. Nobody else can read or write them.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /user_profiles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      // A user can't promote themselves into a household: role/household_id
      // for members are written only by the joinHousehold Cloud Function.
      allow create, update: if signedIn() && request.auth.uid == userId &&
        !(request.resource.data.get('role', null) == 'member' &&
          request.resource.data.get('household_id', null) != resource.data.get('household_id', null));
    }

    match /households/{householdId} {
      allow read: if signedIn() && request.auth.uid in resource.data.member_uids;
      // A new household must belong to its creator, with only them in it.
      allow create: if signedIn() &&
        request.resource.data.owner_uid == request.auth.uid &&
        request.resource.data.member_uids == [request.auth.uid];
      // Only the owner edits it, and can't hand ownership away. Members are
      // added by the joinHousehold Cloud Function after it validates an invite.
      allow update: if signedIn() &&
        request.auth.uid == resource.data.owner_uid &&
        request.resource.data.owner_uid == resource.data.owner_uid;
    }

    match /households/{householdId}/shared_expenses/{expenseId} {
      allow read: if signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.member_uids;
      allow write: if signedIn() &&
        request.auth.uid == get(/databases/$(database)/documents/households/$(householdId)).data.owner_uid;
    }

    match /invites/{token} {
      // Fetching one invite by its secret token is public (the join page shows
      // it before the visitor has an account). Listing the collection is not —
      // that would hand out every token.
      allow get: if true;
      allow list: if false;

      // Only a household owner creates invites, unused, for their own household.
      allow create: if signedIn() &&
        request.resource.data.owner_uid == request.auth.uid &&
        request.resource.data.used == false &&
        get(/databases/$(database)/documents/households/$(request.resource.data.household_id)).data.owner_uid == request.auth.uid;

      // Redeeming happens in the joinHousehold Cloud Function; the owner may
      // revoke (delete) their own invites.
      allow update: if false;
      allow delete: if signedIn() && resource.data.owner_uid == request.auth.uid;
    }
  }
}
