rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the owner's account — and members the owner invited (their profile
    // is written by the joinHousehold Cloud Function, never by clients) — can
    // touch anything. Anyone else can create a Google login, but it gets
    // access to nothing. Keep OWNER in sync with src/config.js and
    // functions/.env (OWNER_UIDS).
    function signedIn() { return request.auth != null; }
    function isOwner()  { return signedIn() && request.auth.uid == 'YJa3cGhuPDeMTlfAJ0LX6LN3AGI2'; }
    function isMember() {
      return signedIn() &&
        get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.get('role', null) == 'member';
    }
    function allowed()  { return isOwner() || isMember(); }

    // Each allowed user's own finances. Nobody else can read or write them.
    match /users/{userId}/{document=**} {
      allow read, write: if allowed() && request.auth.uid == userId;
    }

    match /user_profiles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      // Only the owner writes their own profile; member profiles come from
      // the joinHousehold function, so roles can't be self-assigned.
      allow create, update: if isOwner() && request.auth.uid == userId;
    }

    match /households/{householdId} {
      allow read: if allowed() && request.auth.uid in resource.data.member_uids;
      allow create: if isOwner() &&
        request.resource.data.owner_uid == request.auth.uid &&
        request.resource.data.member_uids == [request.auth.uid];
      // Members are added by joinHousehold after it validates an invite.
      allow update: if isOwner() && resource.data.owner_uid == request.auth.uid &&
        request.resource.data.owner_uid == resource.data.owner_uid;
    }

    match /households/{householdId}/shared_expenses/{expenseId} {
      allow read: if allowed() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.member_uids;
      allow write: if isOwner() &&
        request.auth.uid == get(/databases/$(database)/documents/households/$(householdId)).data.owner_uid;
    }

    match /invites/{token} {
      // Fetching one invite by its secret token is public (the join page shows
      // it before the visitor signs in). Listing would hand out every token.
      allow get: if true;
      allow list: if false;
      allow create: if isOwner() &&
        request.resource.data.owner_uid == request.auth.uid &&
        request.resource.data.used == false;
      // Redeeming happens in joinHousehold; the owner may revoke invites.
      allow update: if false;
      allow delete: if isOwner() && resource.data.owner_uid == request.auth.uid;
    }

    // telegram_links / telegram_chats are server-only (Cloud Functions).
  }
}
