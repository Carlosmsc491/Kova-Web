rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /user_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /households/{householdId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.member_uids;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.owner_uid ||
        // Allow a new member to add themselves — ONLY the member_uids field may
        // change, exactly one uid may be added, and it must be the caller's own.
        // This prevents a self-join request from also rewriting owner_uid,
        // share_parts, or any other field on the household doc.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['member_uids']) &&
         request.resource.data.member_uids.hasAll(resource.data.member_uids) &&
         request.resource.data.member_uids.size() == resource.data.member_uids.size() + 1 &&
         request.auth.uid in request.resource.data.member_uids)
      );
    }

    match /households/{householdId}/shared_expenses/{expenseId} {
      allow read: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.member_uids;
      allow write: if request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/households/$(householdId)).data.owner_uid;
    }

    match /invites/{token} {
      // Public read is required: the join page looks up the invite by token
      // before the visitor has an account or is signed in.
      allow read: if true;

      // Only the household owner may create an invite, and only in the
      // unused state.
      allow create: if request.auth != null &&
        request.resource.data.owner_uid == request.auth.uid &&
        request.resource.data.used == false;

      // The only allowed update is flipping `used` from false to true —
      // nothing else may change, and an already-used invite can never be
      // updated again (blocks replay and prevents rewriting household_id,
      // contributor_id, etc. on someone else's invite).
      allow update: if request.auth != null &&
        resource.data.used == false &&
        request.resource.data.used == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']);
    }
  }
}
